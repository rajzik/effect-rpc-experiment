{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "plugins": [],
    "paths": {
      "@/router": ["./shared/router.ts"],
      "@/server": ["./shared/server.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
