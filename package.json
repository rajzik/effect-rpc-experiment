{
  "name": "effect-trpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "effect-tsgo vp check",
    "lint": "effect-tsgo vp lint",
    "fmt": "vp fmt",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "ready": "effect-tsgo vp check && vp run typecheck && vp run -r test && vp run -r build && node scripts/verify-jsdoc.mjs",
    "docs:check": "node scripts/verify-jsdoc.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
