{
  "name": "@effect-trpc/codegen",
  "version": "0.0.0",
  "bin": {
    "effect-trpc-codegen": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs",
      "default": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "import": "./dist/rollup.mjs",
      "default": "./dist/rollup.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs",
      "default": "./dist/rolldown.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs",
      "default": "./dist/webpack.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "import": "./dist/rspack.mjs",
      "default": "./dist/rspack.mjs"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.mts",
      "import": "./dist/rsbuild.mjs",
      "default": "./dist/rsbuild.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "import": "./dist/esbuild.mjs",
      "default": "./dist/esbuild.mjs"
    },
    "./farm": {
      "types": "./dist/farm.d.mts",
      "import": "./dist/farm.mjs",
      "default": "./dist/farm.mjs"
    },
    "./bun": {
      "types": "./dist/bun.d.mts",
      "import": "./dist/bun.mjs",
      "default": "./dist/bun.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.mts",
      "import": "./dist/loader.mjs",
      "default": "./dist/loader.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@effect-trpc/client": "workspace:*",
    "@effect-trpc/core": "workspace:*",
    "@effect-trpc/server": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "rollup": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
