{
  "name": "@effect-trpc/codegen",
  "version": "0.0.0",
  "bin": {
    "effect-trpc-codegen": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect-trpc/client": "workspace:*",
    "@effect-trpc/core": "workspace:*",
    "@effect-trpc/server": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
